# Used by `npm run dev:mobile` and the android:* scripts (vite --mode mobile).
#
# The app calls its own origin ("/") and the Vite dev server forwards /api and
# /auth to Spring Boot, so a phone or emulator only has to reach Vite.
VITE_API_BASE_URL=/
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_CONTENT_SOURCE=mock
VITE_APP_NAME=Teacher Portal
VITE_ORG_NAME=Rastriya Academy
VITE_BUILD_ID=mobile-dev
