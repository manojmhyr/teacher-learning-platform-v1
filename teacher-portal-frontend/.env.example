# ---------------------------------------------------------------------------
# Teacher Portal configuration
#
# Copy to .env.local and fill in. NEVER put a storage account key or connection
# string here — anything in a VITE_ variable is compiled into the bundle and is
# readable by anyone who opens the app. Secrets belong on the backend.
# ---------------------------------------------------------------------------

# Where lesson content comes from: "mock" (built-in demo data) or "azure".
VITE_CONTENT_SOURCE=mock

# Backend API (Spring Boot). Required when VITE_CONTENT_SOURCE=azure, because
# the backend is what checks entitlement and mints SAS URLs.
VITE_API_BASE_URL=

# Azure Blob service endpoint, e.g. https://lumenacademy.blob.core.windows.net
VITE_AZURE_BLOB_BASE_URL=

# Container holding lesson content.
VITE_AZURE_CONTAINER=lesson-content

# Backend endpoint that mints short-lived read-only SAS URLs.
VITE_SAS_ENDPOINT=/api/content/sas

# How long a minted SAS URL is treated as valid, in seconds. Keep this short.
VITE_SAS_TTL_SECONDS=300

# Branding
VITE_APP_NAME=Teacher Portal
VITE_ORG_NAME=Rastriya Academy

# Set by CI to identify the build in Settings.
VITE_BUILD_ID=dev
