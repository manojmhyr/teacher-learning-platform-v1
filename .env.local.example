# Local full-stack development: UI + API + PostgreSQL on this machine.
# Copy to .env.local and restart `npm run dev`.

# Point the UI at the local backend. With this set, accounts, assignments,
# lessons and teaching records all come from PostgreSQL.
VITE_API_BASE_URL=http://localhost:8080

# Lesson plans, videos and resources still come from built-in demo content
# until Azure is configured. Leave as `mock` for local work.
VITE_CONTENT_SOURCE=mock

VITE_APP_NAME=Teacher Portal
VITE_ORG_NAME=Lumen Academy
VITE_BUILD_ID=local
